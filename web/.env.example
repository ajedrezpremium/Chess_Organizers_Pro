# Chess Organizers Pro - Variables de Entorno
# Copie este archivo a .env.local y ajuste los valores según su entorno

# Configuración de la Aplicación
VITE_APP_NAME=Chess Organizers Pro
VITE_APP_VERSION=1.0.0
VITE_APP_DESCRIPTION=Software profesional para gestión de torneos de ajedrez para árbitros

# Configuración del Backend API
VITE_API_URL=http://localhost:4000/api
VITE_API_TIMEOUT=10000

# Configuración de Autenticación
VITE_AUTH_ENABLED=true
VITE_JWT_SECRET_KEY=tu_clave_secreta_aqui_cambiar_en_produccion
VITE_TOKEN_EXPIRATION_HOURS=24

# Configuración de WebSocket (para actualizaciones en tiempo real)
VITE_WS_URL=ws://localhost:4000/ws
VITE_WS_RECONNECT_INTERVAL=5000
VITE_WS_MAX_RECONNECT_ATTEMPTS=10

# Configuración de FIDE Arbiter Assistant (nuestro diferencial clave)
VITE_FIDE_ASSISTANT_ENABLED=true
VITE_FIDE_ASSISTANT_CACHE_TTL=3600
VITE_FIDE_ASSISTANT_MAX_CONCURRENT_QUERIES=5
VITE_FIDE_ASSISTANT_QUERY_TIMEOUT=5000

# Configuración de Notificaciones
VITE_NOTIFICATIONS_ENABLED=true
VITE_NOTIFICATIONS_SOUND_ENABLED=true
VITE_NOTIFICATIONS_VIBRATION_ENABLED=true
VITE_NOTIFICATIONS_AUTO_DISMISS_MS=5000

# Configuración de TV Wall
VITE_TV_WALL_DEFAULT_REFRESH_INTERVAL=5000
VITE_TV_WALL_AUTO_PLAY_ENABLED=true
VITE_TV_WALL_SHOW_PERFORMANCE_RATINGS=true
VITE_TV_WALL_SHOW_FEDERATION_FLAGS=true

# Configuración de Entrada Móvil de Resultados
VITE_MOBILE_INPUT_HAPTIC_FEEDBACK=true
VITE_MOBILE_INPUT_AUTO_ADVANCE_TABLE=true
VITE_MOBILE_INPUT_SHOW_RECENT_RESULTS=true
VITE_MOBILE_INPUT_RECENT_RESULTS_LIMIT=10

# Configuración de Caché y Rendimiento
VITE_ENABLE_CACHING=true
VITE_CACHE_DEFAULT_TTL=300
VITE_ENABLE_REQUEST_DEDUPLICATION=true
VITE_PRELOAD_NEXT_ROUND_DATA=true

# Configuración de Características Experimentales
VITE_ENABLE_AI_PAIRING_SUGGESTIONS=false
VITE_ENABLE_LIVE_STREAMING_INTEGRATION=false
VITE_ENABLE_ARBITRATOR_CHAT=false
VITE_ENABLE_MULTI_ARBITER_MODE=false

# Configuración de Errores y Reporting
VITE_ENABLE_ERROR_BOUNDARIES=true
VITE_ENABLE_PERFORMANCE_MONITORING=true
VITE_SENTRY_DSN= # Dejar vacío en desarrollo
VITE_REPORT_ERRORS_TO_BACKEND=true

# Configuración de PWA (Progressive Web App)
VITE_PWA_ENABLED=true
VITE_PWA_NAME=Chess Organizers Pro
VITE_PWA_SHORT_NAME=ChessPro
VITE_PWA_DESCRIPTION=Panel de Árbitro Profesional para Torneos de Ajedrez
VITE_PWA_BACKGROUND_COLOR=#0f172a
VITE_PWA_THEME_COLOR=#3b82f6
VITE_PWA_DISPLAY=standalone
VITE_PWA_ORIENTATION=portrait-primary

# Configuración de Internacionalización
VITE_DEFAULT_LANGUAGE=es
VITE_SUPPORTED_LANGUAGES=es,en
VITE_LOCALE_STORAGE_KEY=chess-organizers-language

# Configuración de Accesibilidad
VITE_ENABLE_HIGH_CONTRAST_MODE=true
VITE_ENABLE_NIGHT_MODE=true
VITE_ENABLE_FULLSCREEN_MODE=true
VITE_ENABLE_SCREEN_READER_SUPPORT=true
VITE_ENABLE_KEYBOARD_NAVIGATION=true

# Configuración de Debug (desactivar en producción)
VITE_ENABLE_DEBUG_TOOLS=false
VITE_ENABLE_COMPONENT_BORDERS=false
VITE_ENABLE_PERFORMANCE_OVERLAY=false
VITE_LOG_LEVEL=info # options: error, warn, info, debug, verbose